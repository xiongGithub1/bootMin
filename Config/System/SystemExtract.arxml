    <AR-PACKAGE>
      <SHORT-NAME>CanFrame</SHORT-NAME>
      <ELEMENTS>
        <CAN-FRAME>
          <SHORT-NAME>msg_diag_Request_MyECU_oCAN00</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">UDS physical request (ID 0x74C, Tester -&gt; MyECU), 8 bytes classic CAN. CanTp Rx (physical).</L-2>
          </DESC>
          <FRAME-LENGTH>8</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <SHORT-NAME>msg_diag_Request_MyECU_Tp</SHORT-NAME>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <PDU-REF DEST="N-PDU">/PDU/msg_diag_Request_MyECU_Tp_oCAN00</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
        <CAN-FRAME>
          <SHORT-NAME>msg_diag_RequestGlobal_oCAN00</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">UDS functional request (ID 0x7DF, broadcast), 8 bytes classic CAN. CanTp Rx (functional).</L-2>
          </DESC>
          <FRAME-LENGTH>8</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <SHORT-NAME>msg_diag_RequestGlobal_Tp</SHORT-NAME>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <PDU-REF DEST="N-PDU">/PDU/msg_diag_RequestGlobal_Tp_oCAN00</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
        <CAN-FRAME>
          <SHORT-NAME>msg_diag_Response_MyECU_oCAN00</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">UDS physical response (ID 0x75C, MyECU -&gt; Tester), 8 bytes classic CAN. CanTp Tx.</L-2>
          </DESC>
          <FRAME-LENGTH>8</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <SHORT-NAME>msg_diag_Response_MyECU_Tp</SHORT-NAME>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <PDU-REF DEST="N-PDU">/PDU/msg_diag_Response_MyECU_Tp_oCAN00</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
      </ELEMENTS>
    </AR-PACKAGE>
    <AR-PACKAGE>
      <SHORT-NAME>LinFrame</SHORT-NAME>
