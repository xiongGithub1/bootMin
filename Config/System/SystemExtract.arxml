                      <FRAME-REF DEST="CAN-FRAME">/CanFrame/msg_diag_Request_MyECU_oCAN00</FRAME-REF>
                      <PDU-TRIGGERINGS>
                        <PDU-TRIGGERING-REF-CONDITIONAL>
                          <PDU-TRIGGERING-REF DEST="PDU-TRIGGERING">/Cluster/CAN00/CHNL/PT_msg_diag_Request_MyECU_Tp</PDU-TRIGGERING-REF>
                        </PDU-TRIGGERING-REF-CONDITIONAL>
                      </PDU-TRIGGERINGS>
                      <CAN-ADDRESSING-MODE>STANDARD</CAN-ADDRESSING-MODE>
                      <IDENTIFIER>1868</IDENTIFIER>
                    </CAN-FRAME-TRIGGERING>
                    <CAN-FRAME-TRIGGERING>
                      <SHORT-NAME>FT_msg_diag_RequestGlobal</SHORT-NAME>
                      <FRAME-PORT-REFS>
                        <FRAME-PORT-REF DEST="FRAME-PORT">/ECU/MyECU/CN_CAN00/FP_msg_diag_RequestGlobal_Rx</FRAME-PORT-REF>
                      </FRAME-PORT-REFS>
                      <FRAME-REF DEST="CAN-FRAME">/CanFrame/msg_diag_RequestGlobal_oCAN00</FRAME-REF>
                      <PDU-TRIGGERINGS>
                        <PDU-TRIGGERING-REF-CONDITIONAL>
                          <PDU-TRIGGERING-REF DEST="PDU-TRIGGERING">/Cluster/CAN00/CHNL/PT_msg_diag_RequestGlobal_Tp</PDU-TRIGGERING-REF>
                        </PDU-TRIGGERING-REF-CONDITIONAL>
                      </PDU-TRIGGERINGS>
                      <CAN-ADDRESSING-MODE>STANDARD</CAN-ADDRESSING-MODE>
                      <IDENTIFIER>2015</IDENTIFIER>
                    </CAN-FRAME-TRIGGERING>
                    <CAN-FRAME-TRIGGERING>
                      <SHORT-NAME>FT_msg_diag_Response_MyECU</SHORT-NAME>
                      <FRAME-PORT-REFS>
                        <FRAME-PORT-REF DEST="FRAME-PORT">/ECU/MyECU/CN_CAN00/FP_msg_diag_Response_MyECU_Tx</FRAME-PORT-REF>
                      </FRAME-PORT-REFS>
                      <FRAME-REF DEST="CAN-FRAME">/CanFrame/msg_diag_Response_MyECU_oCAN00</FRAME-REF>
                      <PDU-TRIGGERINGS>
                        <PDU-TRIGGERING-REF-CONDITIONAL>
                          <PDU-TRIGGERING-REF DEST="PDU-TRIGGERING">/Cluster/CAN00/CHNL/PT_msg_diag_Response_MyECU_Tp</PDU-TRIGGERING-REF>
                        </PDU-TRIGGERING-REF-CONDITIONAL>
                      </PDU-TRIGGERINGS>
                      <CAN-ADDRESSING-MODE>STANDARD</CAN-ADDRESSING-MODE>
                      <IDENTIFIER>1884</IDENTIFIER>
                    </CAN-FRAME-TRIGGERING>
                  </FRAME-TRIGGERINGS>
                  <PDU-TRIGGERINGS>
                    <PDU-TRIGGERING>
                      <SHORT-NAME>PT_msg_diag_Request_MyECU</SHORT-NAME>
                      <I-PDU-PORT-REFS>
                        <I-PDU-PORT-REF DEST="I-PDU-PORT">/ECU/MyECU/CN_CAN00/PP_msg_diag_Request_MyECU_Rx</I-PDU-PORT-REF>
                      </I-PDU-PORT-REFS>
                      <I-PDU-REF DEST="DCM-I-PDU">/PDU/msg_diag_Request_MyECU_oCAN00</I-PDU-REF>
                    </PDU-TRIGGERING>
                    <PDU-TRIGGERING>
                      <SHORT-NAME>PT_msg_diag_Request_MyECU_Tp</SHORT-NAME>
                      <I-PDU-PORT-REFS>
                        <I-PDU-PORT-REF DEST="I-PDU-PORT">/ECU/MyECU/CN_CAN00/PP_msg_diag_Request_MyECU_Tp_Rx</I-PDU-PORT-REF>
                      </I-PDU-PORT-REFS>
                      <I-PDU-REF DEST="N-PDU">/PDU/msg_diag_Request_MyECU_Tp_oCAN00</I-PDU-REF>
                    </PDU-TRIGGERING>
                    <PDU-TRIGGERING>
                      <SHORT-NAME>PT_msg_diag_RequestGlobal</SHORT-NAME>
                      <I-PDU-PORT-REFS>
                        <I-PDU-PORT-REF DEST="I-PDU-PORT">/ECU/MyECU/CN_CAN00/PP_msg_diag_RequestGlobal_Rx</I-PDU-PORT-REF>
                      </I-PDU-PORT-REFS>
                      <I-PDU-REF DEST="DCM-I-PDU">/PDU/msg_diag_RequestGlobal_oCAN00</I-PDU-REF>
                    </PDU-TRIGGERING>
                    <PDU-TRIGGERING>
                      <SHORT-NAME>PT_msg_diag_RequestGlobal_Tp</SHORT-NAME>
                      <I-PDU-PORT-REFS>
                        <I-PDU-PORT-REF DEST="I-PDU-PORT">/ECU/MyECU/CN_CAN00/PP_msg_diag_RequestGlobal_Tp_Rx</I-PDU-PORT-REF>
                      </I-PDU-PORT-REFS>
                      <I-PDU-REF DEST="N-PDU">/PDU/msg_diag_RequestGlobal_Tp_oCAN00</I-PDU-REF>
                    </PDU-TRIGGERING>
                    <PDU-TRIGGERING>
                      <SHORT-NAME>PT_msg_diag_Response_MyECU</SHORT-NAME>
                      <I-PDU-PORT-REFS>
                        <I-PDU-PORT-REF DEST="I-PDU-PORT">/ECU/MyECU/CN_CAN00/PP_msg_diag_Response_MyECU_Tx</I-PDU-PORT-REF>
                      </I-PDU-PORT-REFS>
                      <I-PDU-REF DEST="DCM-I-PDU">/PDU/msg_diag_Response_MyECU_oCAN00</I-PDU-REF>
                    </PDU-TRIGGERING>
                    <PDU-TRIGGERING>
                      <SHORT-NAME>PT_msg_diag_Response_MyECU_Tp</SHORT-NAME>
                      <I-PDU-PORT-REFS>
                        <I-PDU-PORT-REF DEST="I-PDU-PORT">/ECU/MyECU/CN_CAN00/PP_msg_diag_Response_MyECU_Tp_Tx</I-PDU-PORT-REF>
                      </I-PDU-PORT-REFS>
                      <I-PDU-REF DEST="N-PDU">/PDU/msg_diag_Response_MyECU_Tp_oCAN00</I-PDU-REF>
                    </PDU-TRIGGERING>
                  </PDU-TRIGGERINGS>
                </CAN-PHYSICAL-CHANNEL>
              </PHYSICAL-CHANNELS>
              <PROTOCOL-NAME>CAN</PROTOCOL-NAME>
            </CAN-CLUSTER-CONDITIONAL>
