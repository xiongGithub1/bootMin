    <AR-PACKAGE>
      <SHORT-NAME>Cluster</SHORT-NAME>
      <ELEMENTS>
        <CAN-CLUSTER>
          <SHORT-NAME>CAN00</SHORT-NAME>
          <LONG-NAME>
            <L-4 L="FOR-ALL">CANFD364</L-4>
          </LONG-NAME>
          <DESC>
            <L-2 L="FOR-ALL">Boot-only communication matrix: UDS diagnostic frames only (no App/Com/Nm). phys req 0x74C, phys resp 0x75C, func req 0x7DF.</L-2>
          </DESC>
          <ADMIN-DATA>
            <SDGS>
              <SDG GID="DV:ToolData">
                <SD GID="DV:ToolName">Vector Legacy Database Converter</SD>
                <SD GID="DV:ToolVersion">1.8.67.0</SD>
              </SDG>
            </SDGS>
          </ADMIN-DATA>
          <CAN-CLUSTER-VARIANTS>
            <CAN-CLUSTER-CONDITIONAL>
              <BAUDRATE>500000</BAUDRATE>
              <PHYSICAL-CHANNELS>
                <CAN-PHYSICAL-CHANNEL>
                  <SHORT-NAME>CHNL</SHORT-NAME>
                  <COMM-CONNECTORS>
                    <COMMUNICATION-CONNECTOR-REF-CONDITIONAL>
                      <COMMUNICATION-CONNECTOR-REF DEST="CAN-COMMUNICATION-CONNECTOR">/ECU/MyECU/CN_CAN00</COMMUNICATION-CONNECTOR-REF>
                    </COMMUNICATION-CONNECTOR-REF-CONDITIONAL>
                  </COMM-CONNECTORS>
                  <FRAME-TRIGGERINGS>
                    <CAN-FRAME-TRIGGERING>
                      <SHORT-NAME>FT_msg_diag_Request_MyECU</SHORT-NAME>
