  req[0] = 0x36; req[1] = 0x01; req[2] = 0xAA; req[3] = 0xBB; req[4] = 0xCC;
  if (ExpNeg(req, 5, 0x36, 0x31)) { TestStepPass("E4", "7F 36 31"); }
  else                            { TestStepFail("E4", "expected ROOR"); }
