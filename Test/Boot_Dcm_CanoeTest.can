  req[0] = 0x22; req[1] = 0xF1; req[2] = 0x98;
  if (ExpNeg(req, 3, 0x22, 0x31)) { TestStepPass("C24", "7F 22 31"); }
  else                            { TestStepFail("C24", "expected ROOR"); }
}

testcase TC_C25()
{
  byte req[2];

  TestCaseTitle("C25", "3E/11 length 1 -> IMLOIF; 11 02 -> SFNS");
  req[0] = 0x3E;
  if (ExpNeg(req, 1, 0x3E, 0x13) == 0) { TestStepFail("C25", "3E expected IMLOIF"); return; }
  req[0] = 0x11;
  if (ExpNeg(req, 1, 0x11, 0x13) == 0) { TestStepFail("C25", "11 expected IMLOIF"); return; }
  req[0] = 0x11; req[1] = 0x02;
  if (ExpNeg(req, 2, 0x11, 0x12)) { TestStepPass("C25", "7F 3E 13 / 7F 11 13 / 7F 11 12"); }
  else                            { TestStepFail("C25", "11 02 expected SFNS"); }
}

testcase TC_C26()
{
  byte req[4];

  TestCaseTitle("C26", "31 03 RequestResults -> SFNS");
  if (EnterSession(0x02) == 0) { TestStepFail("C26", "enter programming"); return; }
  if (DoUnlock(1) == 0)        { TestStepFail("C26", "unlock"); return; }
  req[0] = 0x31; req[1] = 0x03; req[2] = 0xFF; req[3] = 0x01;
  if (ExpNeg(req, 4, 0x31, 0x12)) { TestStepPass("C26", "7F 31 12"); }
  else                            { TestStepFail("C26", "expected SFNS"); }
}

testcase TC_C27()
{
  byte bad[6];
  byte shortWr[5];

  TestCaseTitle("C27", "2E invalid DID / wrong length in extended L1");
  if (EnterSession(0x03) == 0) { TestStepFail("C27", "enter extended"); return; }
  if (DoUnlock(1) == 0)        { TestStepFail("C27", "unlock"); return; }
  bad[0] = 0x2E; bad[1] = 0xF2; bad[2] = 0x00;
  bad[3] = 0x00; bad[4] = 0x00; bad[5] = 0x00;
  if (ExpNeg(bad, 6, 0x2E, 0x31) == 0) { TestStepFail("C27", "invalid DID expected ROOR"); return; }
  shortWr[0] = 0x2E; shortWr[1] = 0xF1; shortWr[2] = 0x80;
  shortWr[3] = 0x01; shortWr[4] = 0xAA;
  if (ExpNeg(shortWr, 5, 0x2E, 0x13)) { TestStepPass("C27", "7F 2E 31 / 7F 2E 13"); }
  else                                { TestStepFail("C27", "short write expected IMLOIF"); }
}

testcase TC_C28()
{
  byte req[2];
  dword len;

  TestCaseTitle("C28", "27 01 seed allowed in extended session");
  if (EnterSession(0x03) == 0) { TestStepFail("C28", "enter extended"); return; }
  req[0] = 0x27; req[1] = 0x01;
  len = UdsRequest(req, 2, gResp, 2000, cReqId);
  if ((len == 6) && (gResp[0] == 0x67) && (gResp[1] == 0x01))
  {
    TestStepPass("C28", "67 01 seed in extended");
  }
  else
  {
    TestStepFail("C28", "seed in extended failed");
  }
}

testcase TC_C29()
{
  byte wr[20];
  byte wrExp[3];
  byte rd[3];
  dword i;

  TestCaseTitle("C29", "2E F198 fingerprint write / not readable by 22");
  if (EnterSession(0x03) == 0) { TestStepFail("C29", "enter extended"); return; }
  if (DoUnlock(1) == 0)        { TestStepFail("C29", "unlock"); return; }
  wr[0] = 0x2E; wr[1] = 0xF1; wr[2] = 0x98;
  for (i = 0; i < 17; i++) { wr[3 + i] = (0xA0 + i) & 0xFF; }
  wrExp[0] = 0x6E; wrExp[1] = 0xF1; wrExp[2] = 0x98;
  if (ExpectResp(wr, 20, wrExp, 3) == 0)
  {
    TestStepFail("C29", "F198 write failed");
    return;
  }
  rd[0] = 0x22; rd[1] = 0xF1; rd[2] = 0x98;
  if (ExpNeg(rd, 3, 0x22, 0x31)) { TestStepPass("C29", "6E F1 98 then 22 -> ROOR"); }
  else                           { TestStepFail("C29", "F198 should not be readable"); }
}

testcase TC_C30()
{
  byte extra[4];
  byte saShort[1];

  TestCaseTitle("C30", "22 extra byte / 27 length 1 -> IMLOIF");
  extra[0] = 0x22; extra[1] = 0xF1; extra[2] = 0x80; extra[3] = 0x00;
  if (ExpNeg(extra, 4, 0x22, 0x13) == 0) { TestStepFail("C30", "22 extra expected IMLOIF"); return; }
  saShort[0] = 0x27;
  if (EnterSession(0x02) == 0) { TestStepFail("C30", "enter programming"); return; }
  if (ExpNeg(saShort, 1, 0x27, 0x13)) { TestStepPass("C30", "7F 22 13 / 7F 27 13"); }
  else                                { TestStepFail("C30", "27 len1 expected IMLOIF"); }
}

testcase TC_C31()
{
  byte req[3];
  dword len;

  TestCaseTitle("C31", "business DIDs ROOR in default/prog; OK in extended");
  ToDefault();
  req[0] = 0x22; req[1] = 0xF1; req[2] = 0x90;
  if (ExpNeg(req, 3, 0x22, 0x31) == 0) { TestStepFail("C31", "default F190 expected ROOR"); return; }
  req[2] = 0x87;
  if (ExpNeg(req, 3, 0x22, 0x31) == 0) { TestStepFail("C31", "default F187 expected ROOR"); return; }
  req[2] = 0x80;
  len = UdsRequest(req, 3, gResp, 2000, cReqId);
  if ((len != 8) || (gResp[0] != 0x62) || (gResp[2] != 0x80))
  {
    TestStepFail("C31", "F180 should be readable in default");
    return;
  }
  if (EnterSession(0x02) == 0) { TestStepFail("C31", "enter programming"); return; }
  req[2] = 0x90;
  if (ExpNeg(req, 3, 0x22, 0x31) == 0) { TestStepFail("C31", "prog F190 expected ROOR"); return; }
  if (EnterSession(0x03) == 0) { TestStepFail("C31", "enter extended"); return; }
  len = UdsRequest(req, 3, gResp, 2000, cReqId);
  if ((len == 20) && (gResp[0] == 0x62) && (gResp[2] == 0x90))
  {
    TestStepPass("C31", "F190/F187 31 in D/P; F180 in D; F190 in E");
  }
  else
  {
    TestStepFail("C31", "F190 in extended failed");
  }
}

/* ---- D. timing ---- */
testcase TC_D1()
{
  byte req[3];
  dword len;

  TestCaseTitle("D1", "P2 latency: 22 F180 within 60 ms");
  req[0] = 0x22; req[1] = 0xF1; req[2] = 0x80;
  len = UdsRequest(req, 3, gResp, 60, cReqId);
  if ((len == 8) && (gResp[0] == 0x62)) { TestStepPass("D1", "response within P2"); }
  else                                  { TestStepFail("D1", "late or missing response"); }
}

testcase TC_D2()
{
  byte req[2];
  byte expect[6];

  TestCaseTitle("D2", "0x10 advertises P2=50ms P2*=5000ms");
  req[0] = 0x10; req[1] = 0x01;
  expect[0] = 0x50; expect[1] = 0x01; expect[2] = 0x00; expect[3] = 0x05; expect[4] = 0x01; expect[5] = 0xF4;
  if (ExpectResp(req, 2, expect, 6)) { TestStepPass("D2", "00 05 / 01 F4"); }
  else                     { TestStepFail("D2", "advertisement mismatch"); }
}

testcase TC_D3()
{
  byte req[11];

  TestCaseTitle("D3", "S3 timeout returns to default session");
  if (EnterSession(0x03) == 0) { TestStepFail("D3", "enter extended"); return; }
  TestWaitForTimeout(cS3Ms + 1000);
  BuildDownloadReq(req, cAppStart, 0x20);
  if (ExpNeg(req, 11, 0x34, 0x7F)) { TestStepPass("D3", "34 -> 7F 34 7F (default)"); }
  else                             { TestStepFail("D3", "session did not expire"); }
}

testcase TC_D4()
{
  byte req[2];
  byte expect[2];
  dword i;

  TestCaseTitle("D4", "3E keepalive prevents S3 expiry");
  if (EnterSession(0x03) == 0) { TestStepFail("D4", "enter extended"); return; }
  req[0] = 0x3E; req[1] = 0x00;
  expect[0] = 0x7E; expect[1] = 0x00;
  for (i = 0; i < 4; i++)
  {
    if (ExpectResp(req, 2, expect, 2) == 0) { TestStepFail("D4", "3E keepalive failed"); return; }
    TestWaitForTimeout(1000);
  }
  req[0] = 0x27; req[1] = 0x01;
  if (ExpNeg(req, 2, 0x27, 0x7F)) { TestStepFail("D4", "session expired"); }
  else                            { TestStepPass("D4", "still in extended (seed request answered)"); }
}

testcase TC_D5()
{
  byte wr[8];
  byte wrExp[3];
  byte sa[2];
  byte wdbi[8];
  byte rd[3];
  byte rdExp[8];

  TestCaseTitle("D5", "S3 to default: unlock cleared, DID RAM reset");
  if (EnterSession(0x03) == 0) { TestStepFail("D5", "enter extended"); return; }
  if (DoUnlock(1) == 0)        { TestStepFail("D5", "unlock"); return; }
  wr[0] = 0x2E; wr[1] = 0xF1; wr[2] = 0x80; wr[3] = 0x01;
  wr[4] = 0xAA; wr[5] = 0xBB; wr[6] = 0xCC; wr[7] = 0xDD;
  wrExp[0] = 0x6E; wrExp[1] = 0xF1; wrExp[2] = 0x80;
  if (ExpectResp(wr, 8, wrExp, 3) == 0) { TestStepFail("D5", "2E while unlocked"); return; }
  TestWaitForTimeout(cS3Ms + 1000);
  sa[0] = 0x27; sa[1] = 0x01;
  if (ExpNeg(sa, 2, 0x27, 0x7F) == 0) { TestStepFail("D5", "27 after S3 expected SNSIAS"); return; }
  wdbi[0] = 0x2E; wdbi[1] = 0xF1; wdbi[2] = 0x80; wdbi[3] = 0x01;
  wdbi[4] = 0x11; wdbi[5] = 0x22; wdbi[6] = 0x33; wdbi[7] = 0x44;
  if (ExpNeg(wdbi, 8, 0x2E, 0x7F) == 0) { TestStepFail("D5", "2E after S3 expected SNSIAS"); return; }
  rd[0] = 0x22; rd[1] = 0xF1; rd[2] = 0x80;
  rdExp[0] = 0x62; rdExp[1] = 0xF1; rdExp[2] = 0x80; rdExp[3] = 0x01;
  rdExp[4] = 0x42; rdExp[5] = 0x4F; rdExp[6] = 0x4F; rdExp[7] = 0x54;
  if (ExpectResp(rd, 3, rdExp, 8)) { TestStepPass("D5", "S3 -> default: 27/2E 7F; F180 restored"); }
  else                            { TestStepFail("D5", "F180 after S3 should be factory BOOT"); }
}

testcase TC_D6()
{
  byte tp[2];
  byte sa[2];
  dword i;
  dword len;

  TestCaseTitle("D6", "3E 80 keepalive then S3 after stop");
  if (EnterSession(0x03) == 0) { TestStepFail("D6", "enter extended"); return; }
  tp[0] = 0x3E; tp[1] = 0x80;
  for (i = 0; i < 6; i++)
  {
    if (ExpNoResp(tp, 2) == 0) { TestStepFail("D6", "3E 80 unexpected response"); return; }
    TestWaitForTimeout(1000);
  }
  sa[0] = 0x27; sa[1] = 0x01;
  len = UdsRequest(sa, 2, gResp, 2000, cReqId);
  if ((len != 6) || (gResp[0] != 0x67))
  {
    TestStepFail("D6", "session dropped despite 3E 80");
    return;
  }
  TestWaitForTimeout(cS3Ms + 1000);
  if (ExpNeg(sa, 2, 0x27, 0x7F)) { TestStepPass("D6", "3E 80 held S3; stop then default"); }
  else                           { TestStepFail("D6", "expected SNSIAS after stop"); }
}

testcase TC_D7()
{
  byte req[2];
  dword len;

  TestCaseTitle("D7", "10 03 response within 20 ms");
  ToDefault();
  req[0] = 0x10; req[1] = 0x03;
  len = UdsRequestEx(req, 2, gResp, 20, cReqId, 0);
  if ((len == 6) && (gResp[0] == 0x50) && (gResp[1] == 0x03))
  {
    TestStepPass("D7", "50 03 within 20 ms");
  }
  else
  {
    TestStepFail("D7", "late or missing 50 03");
  }
}

/* ---- H. CanTp TX serialize (busy/retry; no tester 20 ms gap) ---- */
testcase TC_H1()
{
  byte req[2];
  dword len;
  dword i;
  byte sess[4];

  TestCaseTitle("H1", "back-to-back 10 01/02/03/01 gap=0 (TX serialize)");
  sess[0] = 0x01; sess[1] = 0x02; sess[2] = 0x03; sess[3] = 0x01;
  for (i = 0; i < 4; i++)
  {
    req[0] = 0x10;
    req[1] = sess[i];
    len = UdsRequestEx(req, 2, gResp, 2000, cReqId, 0);
    if ((len != 6) || (gResp[0] != 0x50) || (gResp[1] != sess[i]))
    {
      write("H1: i=%d len=%d SID=%02X", i, len, gResp[0]);
      TestStepFail("H1", "missing 50 xx (TX dropped under full-duplex TX busy?)");
      return;
    }
  }
  TestStepPass("H1", "50 01/02/03/01 all received");
}

testcase TC_H2()
{
  byte req[3];
  dword len;
  dword i;

  TestCaseTitle("H2", "8x 22 F180 gap=0 (consecutive SF TX)");
  req[0] = 0x22; req[1] = 0xF1; req[2] = 0x80;
  for (i = 0; i < 8; i++)
  {
    len = UdsRequestEx(req, 3, gResp, 2000, cReqId, 0);
    if ((len != 8) || (gResp[0] != 0x62) || (gResp[1] != 0xF1) || (gResp[2] != 0x80))
    {
      write("H2: i=%d len=%d", i, len);
      TestStepFail("H2", "22 F180 dropped");
      return;
    }
  }
  TestStepPass("H2", "8 consecutive 62 F180");
}

testcase TC_H3()
{
  byte vin[3];
  byte rd[3];
  byte dsc[2];
  dword len;

  TestCaseTitle("H3", "ext 22 F190 MF TX then 22 F180 then 10 02 gap=0");
  if (EnterSession(0x03) == 0) { TestStepFail("H3", "enter extended"); return; }
  vin[0] = 0x22; vin[1] = 0xF1; vin[2] = 0x90;
  len = UdsRequestEx(vin, 3, gResp, 2000, cReqId, 0);
  if ((len != 20) || (gResp[0] != 0x62) || (gResp[2] != 0x90))
  {
    TestStepFail("H3", "VIN multi-frame failed");
    return;
  }
  rd[0] = 0x22; rd[1] = 0xF1; rd[2] = 0x80;
  len = UdsRequestEx(rd, 3, gResp, 2000, cReqId, 0);
  if ((len != 8) || (gResp[0] != 0x62) || (gResp[2] != 0x80))
  {
    TestStepFail("H3", "F180 after VIN TX dropped");
    return;
  }
  dsc[0] = 0x10; dsc[1] = 0x02;
  len = UdsRequestEx(dsc, 2, gResp, 2000, cReqId, 0);
  if ((len == 6) && (gResp[0] == 0x50) && (gResp[1] == 0x02))
  {
    TestStepPass("H3", "MF then SF then 50 02 kept");
  }
  else
  {
    TestStepFail("H3", "50 02 dropped after MF TX");
  }
}

testcase TC_H4()
{
  byte dsc[2];
  byte req[11];
  dword len;

  TestCaseTitle("H4", "10 02 then immediate 11-byte 34 (SF TX then MF RX)");
  dsc[0] = 0x10; dsc[1] = 0x02;
  len = UdsRequestEx(dsc, 2, gResp, 2000, cReqId, 0);
  if ((len != 6) || (gResp[0] != 0x50))
  {
    TestStepFail("H4", "10 02 failed");
    return;
  }
  BuildDownloadReq(req, cAppStart, 0x20);
  len = UdsRequestEx(req, 11, gResp, 2000, cReqId, 0);
  if ((len == 3) && (gResp[0] == 0x7F) && (gResp[1] == 0x34) && (gResp[2] == 0x33))
  {
    TestStepPass("H4", "FC + 7F 34 33 (locked, TX not dropped)");
  }
  else
  {
    write("H4: len=%d SID=%02X", len, gResp[0]);
    TestStepFail("H4", "expected 7F 34 33 after immediate 34");
  }
}

testcase TC_H5()
{
  byte tp[2];
  byte rd[3];
  dword len;

  TestCaseTitle("H5", "functional 3E 00 then physical 22 F180 gap=0");
  tp[0] = 0x3E; tp[1] = 0x00;
  len = UdsRequestEx(tp, 2, gResp, 2000, cFunctId, 0);
  if ((len != 2) || (gResp[0] != 0x7E))
  {
    TestStepFail("H5", "functional 3E failed");
    return;
  }
  rd[0] = 0x22; rd[1] = 0xF1; rd[2] = 0x80;
  len = UdsRequestEx(rd, 3, gResp, 2000, cReqId, 0);
  if ((len == 8) && (gResp[0] == 0x62) && (gResp[2] == 0x80))
  {
    TestStepPass("H5", "7E 00 then 62 F180 (phys after funct TX)");
  }
  else
  {
    TestStepFail("H5", "physical 22 after functional TX dropped");
  }
}

/* ---- E. flash programming (destructive) ---- */
testcase TC_E1()
{
  byte er[4];
  byte ee[4];
  byte rd[11];
  byte rdExp[4];
  byte td[34];
  byte tdExp[2];
  byte rt[1];
  byte rtExp[1];
  byte cm[8];
  byte cmExp[5];
  byte cd[4];
  dword len;
  dword i;
  dword crc;
  dword j;
  dword b;

  TestCaseTitle("E1", "full download flow");
  if (EnterSession(0x02) == 0) { TestStepFail("E1", "enter programming"); return; }
  if (DoUnlock(1) == 0)        { TestStepFail("E1", "unlock"); return; }
  er[0] = 0x31; er[1] = 0x01; er[2] = 0xFF; er[3] = 0x00;
  ee[0] = 0x71; ee[1] = 0x01; ee[2] = 0xFF; ee[3] = 0x00;
  if (ExpectResp(er, 4, ee, 4) == 0)
  {
    TestStepFail("E1", "erase failed");
    return;
  }
  BuildDownloadReq(rd, cAppStart, 0x20);
  rdExp[0] = 0x74; rdExp[1] = 0x20; rdExp[2] = 0x02; rdExp[3] = 0x00;
  if (ExpectResp(rd, 11, rdExp, 4) == 0)
  {
    TestStepFail("E1", "requestDownload failed");
    return;
  }
  td[0] = 0x36; td[1] = 0x01;
  for (i = 0; i < 32; i++) { td[2 + i] = i & 0xFF; }
  tdExp[0] = 0x76; tdExp[1] = 0x01;
  if (ExpectResp(td, 34, tdExp, 2) == 0) { TestStepFail("E1", "transferData failed"); return; }
  rt[0] = 0x37;
  rtExp[0] = 0x77;
  if (ExpectResp(rt, 1, rtExp, 1) == 0)  { TestStepFail("E1", "transferExit failed"); return; }
  /* Stream CRC of payload 00..1F (IEEE CRC32) */
  crc = 0xFFFFFFFF;
  for (i = 0; i < 32; i++)
  {
    b = i & 0xFF;
    crc = crc ^ b;
    for (j = 0; j < 8; j++)
    {
      if ((crc & 1) != 0) { crc = (crc >> 1) ^ 0xEDB88320; }
      else                { crc = crc >> 1; }
    }
  }
  crc = crc ^ 0xFFFFFFFF;
  cm[0] = 0x31; cm[1] = 0x01; cm[2] = 0xFF; cm[3] = 0x02;
  cm[4] = (crc >> 24) & 0xFF;
  cm[5] = (crc >> 16) & 0xFF;
  cm[6] = (crc >> 8) & 0xFF;
  cm[7] = crc & 0xFF;
  cmExp[0] = 0x71; cmExp[1] = 0x01; cmExp[2] = 0xFF; cmExp[3] = 0x02; cmExp[4] = 0x00;
  if (ExpectResp(cm, 8, cmExp, 5) == 0)
  {
    TestStepFail("E1", "checkMemory failed");
    return;
  }
  cd[0] = 0x31; cd[1] = 0x01; cd[2] = 0xFF; cd[3] = 0x01;
  len = UdsRequest(cd, 4, gResp, 2000, cReqId);
  if ((len == 5) && (gResp[0] == 0x71) && (gResp[1] == 0x01) &&
      (gResp[2] == 0xFF) && (gResp[3] == 0x01) && (gResp[4] == 0x00))
  {
    TestStepPass("E1", "full flow OK");
  }
  else
  {
    TestStepFail("E1", "checkDependency failed");
  }
}

testcase TC_E2()
{
  byte req[34];
  dword i;

  TestCaseTitle("E2", "36 wrong block counter -> WBSC");
  if (ProgErased() == 0) { TestStepFail("E2", "precondition"); return; }
  if (StartDownload(cAppStart, 0x20) == 0) { TestStepFail("E2", "requestDownload"); return; }
  req[0] = 0x36; req[1] = 0x02;
  for (i = 0; i < 32; i++) { req[2 + i] = i & 0xFF; }
  if (ExpNeg(req, 34, 0x36, 0x73)) { TestStepPass("E2", "7F 36 73"); }
  else                             { TestStepFail("E2", "expected WBSC"); }
}

testcase TC_E3()
