testcase TC_C12()
{
  byte req[11];

  TestCaseTitle("C12", "34 in default -> SNSIAS");
  BuildDownloadReq(req, cAppStart, 0x20);
  if (ExpNeg(req, 11, 0x34, 0x7F)) { TestStepPass("C12", "7F 34 7F"); }
  else                             { TestStepFail("C12", "expected SNSIAS"); }
}

