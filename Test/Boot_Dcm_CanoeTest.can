  req[0] = 0x36; req[1] = 0x01;
  for (i = 0; i < 40; i++) { req[2 + i] = i & 0xFF; }
  if (ExpNeg(req, 42, 0x36, 0x31)) { TestStepPass("E3", "7F 36 31"); }
  else                             { TestStepFail("E3", "expected ROOR"); }
}

