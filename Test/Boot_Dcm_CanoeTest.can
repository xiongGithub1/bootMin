testcase TC_E14()
{
  byte td[34];
  byte rt[1];
  byte chk[4];
  byte rd[11];
  byte rdExp[4];
  dword i;

  TestCaseTitle("E14", "order: 36/37/31 FF02 before 34 after erase");
  if (ProgErased() == 0) { TestStepFail("E14", "precondition"); return; }
  td[0] = 0x36; td[1] = 0x01;
  for (i = 0; i < 32; i++) { td[2 + i] = i & 0xFF; }
  if (ExpNeg(td, 34, 0x36, 0x24) == 0) { TestStepFail("E14", "36 before 34 expected RSE"); return; }
  rt[0] = 0x37;
  if (ExpNeg(rt, 1, 0x37, 0x24) == 0) { TestStepFail("E14", "37 before 34 expected RSE"); return; }
  chk[0] = 0x31; chk[1] = 0x01; chk[2] = 0xFF; chk[3] = 0x02;
  if (ExpNeg(chk, 4, 0x31, 0x22) == 0) { TestStepFail("E14", "FF02 before 37 expected CNC"); return; }
  chk[3] = 0x01;
  if (ExpNeg(chk, 4, 0x31, 0x22) == 0) { TestStepFail("E14", "FF01 before 37 expected CNC"); return; }
  BuildDownloadReq(rd, cAppStart, 0x20);
  rdExp[0] = 0x74; rdExp[1] = 0x20; rdExp[2] = 0x02; rdExp[3] = 0x00;
  if (ExpectResp(rd, 11, rdExp, 4)) { TestStepPass("E14", "7F 36 24 / 37 24 / 31 22 then 74 still OK"); }
  else                               { TestStepFail("E14", "34 after rejected 36/37 should still work"); }
}

testcase TC_E15()
{
  byte rd[11];
  byte er[4];
  byte chk[4];
  byte td[34];
  byte tdExp[2];
  dword i;

  TestCaseTitle("E15", "order: 34 twice / erase / FF02 during download");
  if (ProgErased() == 0) { TestStepFail("E15", "precondition"); return; }
  if (StartDownload(cAppStart, 0x20) == 0) { TestStepFail("E15", "first 34"); return; }
  BuildDownloadReq(rd, cAppStart, 0x20);
  if (ExpNeg(rd, 11, 0x34, 0x22) == 0) { TestStepFail("E15", "second 34 expected CNC"); return; }
  er[0] = 0x31; er[1] = 0x01; er[2] = 0xFF; er[3] = 0x00;
  if (ExpNeg(er, 4, 0x31, 0x22) == 0) { TestStepFail("E15", "erase during 36 expected CNC"); return; }
  chk[0] = 0x31; chk[1] = 0x01; chk[2] = 0xFF; chk[3] = 0x02;
  if (ExpNeg(chk, 4, 0x31, 0x22) == 0) { TestStepFail("E15", "FF02 during 36 expected CNC"); return; }
  td[0] = 0x36; td[1] = 0x01;
  for (i = 0; i < 32; i++) { td[2 + i] = i & 0xFF; }
  tdExp[0] = 0x76; tdExp[1] = 0x01;
  if (ExpectResp(td, 34, tdExp, 2)) { TestStepPass("E15", "7F 34 22 / 31 22 then 76 01 still OK"); }
  else                               { TestStepFail("E15", "36 after rejected 34/31 should still work"); }
}

testcase TC_E16()
{
  byte td[34];
  byte rt[1];
  byte rd[11];
  byte ff01[4];
  byte ff02[4];
  byte er[4];
  byte ee[4];
  byte rdExp[4];
  dword i;

  TestCaseTitle("E16", "order: after 37 no re-erase; FF01 then FF02");
  if (ProgErased() == 0) { TestStepFail("E16", "precondition"); return; }
  if (DoDownload32() == 0) { TestStepFail("E16", "34+36+37"); return; }
  td[0] = 0x36; td[1] = 0x01;
  for (i = 0; i < 32; i++) { td[2 + i] = i & 0xFF; }
  if (ExpNeg(td, 34, 0x36, 0x24) == 0) { TestStepFail("E16", "36 after 37 expected RSE"); return; }
  rt[0] = 0x37;
  if (ExpNeg(rt, 1, 0x37, 0x24) == 0) { TestStepFail("E16", "37 twice expected RSE"); return; }
  BuildDownloadReq(rd, cAppStart, 0x20);
  if (ExpNeg(rd, 11, 0x34, 0x22) == 0) { TestStepFail("E16", "34 without re-erase expected CNC"); return; }
  ff01[0] = 0x31; ff01[1] = 0x01; ff01[2] = 0xFF; ff01[3] = 0x01;
  if ((UdsRequest(ff01, 4, gResp, 2000, cReqId) < 4) || (gResp[0] != 0x71))
  {
    TestStepFail("E16", "FF01 after 37 should pass");
    return;
  }
  ff02[0] = 0x31; ff02[1] = 0x01; ff02[2] = 0xFF; ff02[3] = 0x02;
  if (ExpNeg(ff02, 4, 0x31, 0x22) == 0) { TestStepFail("E16", "FF02 after FF01 expected CNC"); return; }
  er[0] = 0x31; er[1] = 0x01; er[2] = 0xFF; er[3] = 0x00;
  ee[0] = 0x71; ee[1] = 0x01; ee[2] = 0xFF; ee[3] = 0x00;
  if (ExpectResp(er, 4, ee, 4) == 0) { TestStepFail("E16", "re-erase after CHECKED"); return; }
  BuildDownloadReq(rd, cAppStart, 0x20);
  rdExp[0] = 0x74; rdExp[1] = 0x20; rdExp[2] = 0x02; rdExp[3] = 0x00;
  if (ExpectResp(rd, 11, rdExp, 4)) { TestStepPass("E16", "after 37: 36/37/34 NRC; FF01 then FF02 CNC; re-erase OK"); }
  else                               { TestStepFail("E16", "34 after re-erase failed"); }
}

testcase TC_E18()
{
  byte rd[11];
  byte rdExp[4];
  byte dsc[2];
  byte td[34];
  byte tdExp[2];
  dword i;

  TestCaseTitle("E18", "10 03 during download -> CNC; 36 still works");
  if (ProgErased() == 0) { TestStepFail("E18", "precondition"); return; }
  BuildDownloadReq(rd, cAppStart, 0x20);
  rdExp[0] = 0x74; rdExp[1] = 0x20; rdExp[2] = 0x02; rdExp[3] = 0x00;
  if (ExpectResp(rd, 11, rdExp, 4) == 0) { TestStepFail("E18", "34 failed"); return; }
  dsc[0] = 0x10; dsc[1] = 0x03;
  if (ExpNeg(dsc, 2, 0x10, 0x22) == 0) { TestStepFail("E18", "10 03 during 34 expected CNC"); return; }
  td[0] = 0x36; td[1] = 0x01;
  for (i = 0; i < 32; i++) { td[2 + i] = i & 0xFF; }
  tdExp[0] = 0x76; tdExp[1] = 0x01;
  if (ExpectResp(td, 34, tdExp, 2)) { TestStepPass("E18", "7F 10 22 then 76 01"); }
  else                               { TestStepFail("E18", "36 after rejected 10 03 should still work"); }
}

/* ---- F. ECU reset ---- */
testcase TC_F1()
{
  byte er[2];
  byte erExp[2];
  byte re[2];
  byte reExp[6];

  TestCaseTitle("F1", "11 01 hardReset + ECU comes back");
  er[0] = 0x11; er[1] = 0x01;
  erExp[0] = 0x51; erExp[1] = 0x01;
  if (ExpectResp(er, 2, erExp, 2) == 0) { TestStepFail("F1", "no 51 01"); return; }
  TestWaitForTimeout(3000);
  re[0] = 0x10; re[1] = 0x01;
  reExp[0] = 0x50; reExp[1] = 0x01; reExp[2] = 0x00; reExp[3] = 0x05; reExp[4] = 0x01; reExp[5] = 0xF4;
  if (ExpectResp(re, 2, reExp, 6)) { TestStepPass("F1", "ECU re-initialized"); }
  else                      { TestStepFail("F1", "no response after reset"); }
}

testcase TC_F2()
{
  byte er[2];
  byte erExp[2];
  byte re[2];
  byte reExp[6];

  TestCaseTitle("F2", "11 03 softReset + ECU comes back");
  er[0] = 0x11; er[1] = 0x03;
  erExp[0] = 0x51; erExp[1] = 0x03;
  if (ExpectResp(er, 2, erExp, 2) == 0) { TestStepFail("F2", "no 51 03"); return; }
  TestWaitForTimeout(2000);
  re[0] = 0x10; re[1] = 0x01;
  reExp[0] = 0x50; reExp[1] = 0x01; reExp[2] = 0x00; reExp[3] = 0x05; reExp[4] = 0x01; reExp[5] = 0xF4;
  if (ExpectResp(re, 2, reExp, 6)) { TestStepPass("F2", "ECU re-initialized"); }
  else                      { TestStepFail("F2", "no response after reset"); }
}

testcase TC_F3()
{
  byte req[2];

  TestCaseTitle("F3", "11 02 invalid sub-function -> SFNS");
  req[0] = 0x11; req[1] = 0x02;
  if (ExpNeg(req, 2, 0x11, 0x12)) { TestStepPass("F3", "7F 11 12"); }
  else                            { TestStepFail("F3", "expected SFNS"); }
}

testcase TC_F4()
{
  byte er[2];
  byte erExp[2];
  byte re[2];
  byte reExp[6];
  byte sa[2];

  TestCaseTitle("F4", "11 01 from extended returns to default");
  if (EnterSession(0x03) == 0) { TestStepFail("F4", "enter extended"); return; }
  er[0] = 0x11; er[1] = 0x01;
  erExp[0] = 0x51; erExp[1] = 0x01;
  if (ExpectResp(er, 2, erExp, 2) == 0) { TestStepFail("F4", "no 51 01"); return; }
  TestWaitForTimeout(3000);
  re[0] = 0x10; re[1] = 0x01;
  reExp[0] = 0x50; reExp[1] = 0x01; reExp[2] = 0x00; reExp[3] = 0x05; reExp[4] = 0x01; reExp[5] = 0xF4;
  if (ExpectResp(re, 2, reExp, 6) == 0) { TestStepFail("F4", "no 50 01 after reset"); return; }
  sa[0] = 0x27; sa[1] = 0x01;
  if (ExpNeg(sa, 2, 0x27, 0x7F)) { TestStepPass("F4", "back in default (27 -> 7F)"); }
  else                           { TestStepFail("F4", "expected SNSIAS after reset"); }
}

/* ---- G. functional addressing ---- */
testcase TC_G1()
{
  byte req[2];
  dword len;

  TestCaseTitle("G1", "functional 3E 00 via 0x7DF");
  req[0] = 0x3E; req[1] = 0x00;
  len = UdsRequest(req, 2, gResp, 2000, cFunctId);
  if ((len == 2) && (gResp[0] == 0x7E) && (gResp[1] == 0x00)) { TestStepPass("G1", "7E 00"); }
  else                                                        { TestStepFail("G1", "response mismatch"); }
}

testcase TC_G2()
{
  byte req[3];
  dword len;

  TestCaseTitle("G2", "functional 22 F180 via 0x7DF");
  req[0] = 0x22; req[1] = 0xF1; req[2] = 0x80;
  len = UdsRequest(req, 3, gResp, 2000, cFunctId);
  if ((len == 8) && (gResp[0] == 0x62) && (gResp[1] == 0xF1) && (gResp[2] == 0x80) &&
      (gResp[3] == 0x01) && (gResp[4] == 0x42) && (gResp[5] == 0x4F) &&
      (gResp[6] == 0x4F) && (gResp[7] == 0x54))
  {
    TestStepPass("G2", "62 F1 80 01 42 4F 4F 54");
  }
  else
  {
    TestStepFail("G2", "response mismatch");
  }
}

testcase TC_G3()
{
  byte req[2];
  dword len;

  TestCaseTitle("G3", "functional 10 01 via 0x7DF");
  req[0] = 0x10; req[1] = 0x01;
  len = UdsRequest(req, 2, gResp, 2000, cFunctId);
  if ((len == 6) && (gResp[0] == 0x50) && (gResp[1] == 0x01) &&
      (gResp[2] == 0x00) && (gResp[3] == 0x05) &&
      (gResp[4] == 0x01) && (gResp[5] == 0xF4))
  {
    TestStepPass("G3", "50 01 00 05 01 F4");
  }
  else
  {
    TestStepFail("G3", "response mismatch");
  }
}

