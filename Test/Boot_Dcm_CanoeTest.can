/*@!Encoding:1252*/
/**
 * Boot_Dcm_CanoeTest.can
 * ------------------------------------------------------------------
 * CANoe CAPL test module for the table-driven UDS/DCM of
 * autosarTc364_Boot (2).
 *
 * Test matrix (see Boot_Dcm_TestSpec.md):
 *   A1..A18 DiagnosticSessionControl / switch matrix / S3 / isolation (A17 gated)
 *   B1..B13 SecurityAccess (L1 / L3, NRC 0x12/0x13/0x24/0x35/0x36/0x37)
 *   C1..C31 service permission matrix + DID / NRC
 *   D1..D7  P2 / P2* advertisement, P2 latency, S3, 3E 80 keepalive
 *   H1..H5  CanTp TX serialize: back-to-back requests (no 20 ms tester gap)
 *   E1..E18 flash programming flow + service order (destructive, gated)
 *   F1/F2/F4 ECU reset (gated); F3 11 02 SFNS always
 *   G1..G3  functional addressing (0x7DF)
 *
 * CAN IDs / bitrate come from the project configuration:
 *   request (physical) 0x74C, response 0x75C, functional 0x7DF, 500 kbit/s.
 *
 * How to run in CANoe:
 *   1. Create/open a CANoe configuration with a CAN channel at 500 kbit/s
 *      connected to the ECU under test.
 *   2. Test Setup -> right-click -> Insert Test Environment -> Test Module
 *      (CAPL) -> select this file.
 *   3. Compile (F7) and run the test module.
 *   4. Optional: set gRunFlash = 1 / gRunReset = 1 in the variables block
 *      to enable the destructive flash and reset tests.
 *
 * No DBC / diagnostic description (CDD) is required: the module implements
 * the ISO-TP single/multi frame handling itself on raw CAN messages.
 */

includes
{
}

variables
{
  /* ---- CAN identifiers (project config) ---- */
  const dword cReqId   = 0x74C;   /* physical diagnostic request  */
  const dword cRespId  = 0x75C;   /* response / flow control     */
  const dword cFunctId = 0x7DF;   /* functional request          */

  /* ---- server timings ---- */
  const dword cP2Ms     = 50;
  const dword cP2StarMs = 5000;
  const dword cS3Ms     = 5000;

  /* ---- test data ---- */
  const dword cAppStart = 0x80020000;

  /* CAPL requires a numeric ID when no DBC message type is available */
  message 0x000 gReq;           /* request / flow-control frame to the ECU  */
  message 0x000 gFrame;         /* received frame from the ECU              */
  byte     gResp[512];          /* last received UDS response               */

  /* RX queue: ZXDoc listens continuously; TestWaitForMessage-after-send
   * misses the ISO-TP FC that arrives immediately after a First Frame. */
  byte gQData[32];
  byte gQDlc[4];
  int  gQRd;
  int  gQWr;
  int  gQCnt;

  /* ---- enable switches (set to 1 to run destructive tests) ---- */
  int gRunFlash = 0;            /* E1..E18 erase the APP area!              */
  int gRunReset = 0;            /* F1/F2/F4 reset the ECU; F3 always runs   */
  int gRunStress = 0;           /* A17: 1000 session-switch cycles          */
}

/* =====================================================================
 * ISO-TP helpers (tester side)
 * ===================================================================== */

on message 0x75C
{
  dword i;
  dword base;

  if (gQCnt >= 4)
  {
    return;
  }
  base = gQWr * 8;
  gQDlc[gQWr] = this.dlc;
  for (i = 0; i < 8; i++)
  {
    gQData[base + i] = this.byte(i);
  }
  gQWr = (gQWr + 1) % 4;
  gQCnt = gQCnt + 1;
}

void RxDrain(void)
{
  gQRd = 0;
  gQWr = 0;
  gQCnt = 0;
}

int RxPop(void)
{
  dword i;
  dword base;

  if (gQCnt <= 0)
  {
    return 0;
  }
  base = gQRd * 8;
  gFrame.id = cRespId;
  gFrame.dlc = gQDlc[gQRd];
  for (i = 0; i < 8; i++)
  {
    gFrame.byte(i) = gQData[base + i];
  }
  gQRd = (gQRd + 1) % 4;
  gQCnt = gQCnt - 1;
  return 1;
}

/* Send one CAN-TP frame.
 * Boot CanIf has DLC check ON and requires DLC==8 (see CanIf_RxPduConfig).
 * ZXDoc pads to 8; CAPL must do the same or ECU drops the frame. */
void SendRaw(dword txId, byte frame[], dword len)
{
  dword i;

  if (len > 8)
  {
    len = 8;
  }

  gReq.id = txId;
  gReq.dlc = 8;                 /* always 8: match CanIf DLC check */
  for (i = 0; i < len; i++)
  {
    gReq.byte(i) = frame[i];
  }
  for (; i < 8; i++)
  {
    gReq.byte(i) = 0x00;        /* pad unused bytes */
  }
  output(gReq);
}

/* Wait for one CAN-TP frame with ID cRespId. Returns 1 on success. */
int WaitRaw(dword timeout)
{
  dword waited;

  waited = 0;
  while (waited < timeout)
  {
    if (RxPop() != 0)
    {
      return 1;
    }
    TestWaitForTimeout(1);
    waited += 1;
  }
  return RxPop();
}

/* Wait until a 0x75C frame whose PCI nibble matches pciHi (e.g. 0x30 = FC).
 * Retry/late copies of the previous UDS response must not be treated as FC. */
int WaitRawPci(dword timeout, byte pciHi)
{
  dword waited;

  waited = 0;
  while (waited < timeout)
  {
    if (WaitRaw(50) == 0)
    {
      waited += 50;
    }
    else if ((gFrame.byte(0) & 0xF0) == pciHi)
    {
      return 1;
    }
    else
    {
      waited += 1;
    }
  }
  return 0;
}

/* Send a UDS request (single frame or first/consecutive frames). */
void SendTp(byte data[], dword len, dword txId)
{
  dword i;
  dword off;
  dword seq;
  dword n;
  dword bs;
  dword stmin;
  dword sent;
  byte  frame[8];

  if (len <= 7)
  {
    frame[0] = len;
    for (i = 0; i < len; i++)
    {
      frame[1 + i] = data[i];
    }
    SendRaw(txId, frame, 1 + len);
    return;
  }

  /* first frame */
  frame[0] = 0x10 | ((len >> 8) & 0x0F);
  frame[1] = len & 0xFF;
  for (i = 0; i < 6; i++)
  {
    if (i < len)
    {
      frame[2 + i] = data[i];
    }
    else
    {
      frame[2 + i] = 0;
    }
  }
  SendRaw(txId, frame, 8);

  /* wait for flow control (skip leftover 50 xx / 67 xx from the previous step) */
  if (WaitRawPci(1000, 0x30) == 0)
  {
    write("ISO-TP: no flow control for request");
    return;
  }

  bs    = gFrame.byte(1);
  stmin = gFrame.byte(2) & 0x7F;
  off   = 6;
  seq   = 1;
  sent  = 0;

  while (off < len)
  {
    /* honor block size: wait for a further FC after each block */
    if ((bs > 0) && (sent > 0) && ((sent % bs) == 0))
    {
      if (WaitRawPci(1000, 0x30) == 0)
      {
        write("ISO-TP: no further flow control");
        return;
      }
      stmin = gFrame.byte(2) & 0x7F;
    }

    n = len - off;
    if (n > 7)
    {
      n = 7;
    }
    frame[0] = 0x20 | (seq & 0x0F);
    for (i = 0; i < n; i++)
    {
      frame[1 + i] = data[off + i];
    }
    SendRaw(txId, frame, 1 + n);

    /* ECU CanTp processes one frame per main cycle */
    if (stmin > 0)
    {
      TestWaitForTimeout(stmin);
    }
    else
    {
      TestWaitForTimeout(5);
    }

    off  += n;
    seq  += 1;
    sent += 1;
  }
}

/* Wait for a complete UDS response. Returns length, 0 on timeout. */
dword WaitTp(byte resp[], dword timeout)
{
  dword total;
  dword off;
  dword i;
  dword waited;
  byte  pci;
  byte  fc[3];

  waited = 0;
  pci = 0xFF;
  while (waited < timeout)
  {
    if (WaitRaw(50) == 0)
    {
      waited += 50;
    }
    else
    {
      pci = gFrame.byte(0) & 0xF0;
      if ((pci == 0x00) || (pci == 0x10))
      {
        break;
      }
      waited += 1;
      pci = 0xFF;
    }
  }
  if ((pci != 0x00) && (pci != 0x10))
  {
    return 0;
  }

  /* single frame */
  if ((gFrame.byte(0) & 0xF0) == 0x00)
  {
    total = gFrame.byte(0) & 0x0F;
    for (i = 0; i < total; i++)
    {
      resp[i] = gFrame.byte(1 + i);
    }
    return total;
  }

  /* first frame */
  if ((gFrame.byte(0) & 0xF0) == 0x10)
  {
    total = ((gFrame.byte(0) & 0x0F) << 8) | gFrame.byte(1);
    off = 0;
    for (i = 2; (i < 8) && (off < total); i++)
    {
      resp[off] = gFrame.byte(i);
      off++;
    }

    /* send flow control: CTS, block size 0, STmin 0 */
    fc[0] = 0x30;
    fc[1] = 0x00;
    fc[2] = 0x00;
    SendRaw(cReqId, fc, 3);

    while (off < total)
    {
      if (WaitRaw(timeout) == 0)
      {
        return 0;
      }
      if ((gFrame.byte(0) & 0xF0) == 0x20)
      {
        for (i = 1; (i < 8) && (off < total); i++)
        {
          resp[off] = gFrame.byte(i);
          off++;
        }
      }
    }
    return total;
  }

  return 0;
}

/* Send a request and wait for the response. Returns response length.
 * gapMs: tester delay after the previous response. 0 = fire as soon as the
 * last UDS PDU is complete (stresses Boot TX busy/retry: CanTp FULL_DUPLEX
 * still allows only one outstanding Tx N-PDU on 0x75C). */
dword UdsRequestEx(byte req[], dword reqLen, byte resp[], dword timeout, dword txId, dword gapMs)
{
  if (gapMs > 0)
  {
    TestWaitForTimeout(gapMs);
  }
  RxDrain();
  SendTp(req, reqLen, txId);
  return WaitTp(resp, timeout);
}

dword UdsRequest(byte req[], dword reqLen, byte resp[], dword timeout, dword txId)
{
  return UdsRequestEx(req, reqLen, resp, timeout, txId, 20);
}

/* ---------- expectation helpers ------------------------------------- */
/* Named ExpectResp (not Exp) to avoid clashing with CAPL math exp(). */
int ExpectResp(byte req[], dword reqLen, byte expect[], dword expectLen)
{
  dword len;
  dword i;

  len = UdsRequest(req, reqLen, gResp, 2000, cReqId);
  if (len != expectLen)
  {
    if (len == 0)
    {
      write("ExpectResp: timeout, expected len=%d", expectLen);
    }
    else if ((len >= 3) && (gResp[0] == 0x7F))
    {
      write("ExpectResp: NRC 7F %02X %02X (len=%d), expected pos len=%d", gResp[1], gResp[2], len, expectLen);
    }
    else
    {
      write("ExpectResp: SID=%02X len=%d, expected len=%d", gResp[0], len, expectLen);
    }
    return 0;
  }
  for (i = 0; i < len; i++)
  {
    if (gResp[i] != expect[i])
    {
      write("ExpectResp: mismatch at [%d] got %02X expect %02X", i, gResp[i], expect[i]);
      return 0;
    }
  }
  return 1;
}

int ExpNeg(byte req[], dword reqLen, dword sid, dword nrc)
{
  dword len;

  len = UdsRequest(req, reqLen, gResp, 2000, cReqId);
  if ((len == 3) && (gResp[0] == 0x7F) && (gResp[1] == sid) && (gResp[2] == nrc))
  {
    return 1;
  }
  if (len == 0)
  {
    write("ExpNeg: timeout, expected 7F %02X %02X", sid, nrc);
  }
  else if ((len >= 3) && (gResp[0] == 0x7F))
  {
    write("ExpNeg: got 7F %02X %02X, expected 7F %02X %02X", gResp[1], gResp[2], sid, nrc);
  }
  else
  {
    write("ExpNeg: got SID=%02X len=%d, expected 7F %02X %02X", gResp[0], len, sid, nrc);
  }
  return 0;
}

int ExpNoResp(byte req[], dword reqLen)
{
  return (UdsRequest(req, reqLen, gResp, 500, cReqId) == 0);
}

/* ---------- state helpers ------------------------------------------- */
void ToDefault(void)
{
  byte req[2];

  req[0] = 0x10;
  req[1] = 0x01;
  UdsRequest(req, 2, gResp, 1000, cReqId);
  TestWaitForTimeout(100);
}

int EnterSession(dword session)
{
  byte req[2];
  dword len;

  req[0] = 0x10;
  req[1] = session;
  len = UdsRequest(req, 2, gResp, 2000, cReqId);
  return ((len >= 2) && (gResp[0] == 0x50) && (gResp[1] == session));
}

int ExpectDsc(dword session)
{
  byte req[2];
  byte expect[6];

  req[0] = 0x10;
  req[1] = session;
  expect[0] = 0x50;
  expect[1] = session;
  expect[2] = 0x00;
  expect[3] = 0x05;
  expect[4] = 0x01;
  expect[5] = 0xF4;
  return ExpectResp(req, 2, expect, 6);
}

int DoUnlock(dword level)
{
  byte req[6];
  dword len;
  dword seed;
  dword secKey;   /* not named 'key': CAPL reserves key for on key */
  dword seedSf;
  dword keySf;

  if (level == 1)
  {
    seedSf = 0x01;
    keySf  = 0x02;
  }
  else
  {
    seedSf = 0x03;
    keySf  = 0x04;
  }

  req[0] = 0x27;
  req[1] = seedSf;
  len = UdsRequest(req, 2, gResp, 2000, cReqId);
  if ((len != 6) || (gResp[0] != 0x67) || (gResp[1] != seedSf))
  {
    return 0;
  }

  seed = (((dword)gResp[2]) << 24) |
         (((dword)gResp[3]) << 16) |
         (((dword)gResp[4]) << 8)  |
         ((dword)gResp[5]);
  /* secKey = bitwise NOT of seed */
  secKey = seed ^ 0xFFFFFFFF;

  req[0] = 0x27;
  req[1] = keySf;
  req[2] = (secKey >> 24) & 0xFF;
  req[3] = (secKey >> 16) & 0xFF;
  req[4] = (secKey >> 8) & 0xFF;
  req[5] = secKey & 0xFF;
  len = UdsRequest(req, 6, gResp, 2000, cReqId);
  return ((len == 2) && (gResp[0] == 0x67) && (gResp[1] == keySf));
}

int RestoreF180(void)
{
  byte wr[8];
  byte wrExp[3];

  if (EnterSession(0x03) == 0)
  {
    return 0;
  }
  if (DoUnlock(1) == 0)
  {
    return 0;
  }
  wr[0] = 0x2E; wr[1] = 0xF1; wr[2] = 0x80; wr[3] = 0x01;
  wr[4] = 0x42; wr[5] = 0x4F; wr[6] = 0x4F; wr[7] = 0x54;
  wrExp[0] = 0x6E; wrExp[1] = 0xF1; wrExp[2] = 0x80;
  return ExpectResp(wr, 8, wrExp, 3);
}

/* Request L1 seed then send a wrong key. Returns 1 if NRC matches expectNrc. */
int SendWrongKey(dword expectNrc)
{
  byte req[6];
  dword len;
  dword seed;
  dword wrong;

  req[0] = 0x27;
  req[1] = 0x01;
  len = UdsRequest(req, 2, gResp, 2000, cReqId);
  if ((len != 6) || (gResp[0] != 0x67) || (gResp[1] != 0x01))
  {
    return 0;
  }
  seed = (((dword)gResp[2]) << 24) | (((dword)gResp[3]) << 16) |
         (((dword)gResp[4]) << 8)  | ((dword)gResp[5]);
  wrong = (seed ^ 0xFFFFFFFF) ^ 0x55;
  req[0] = 0x27;
  req[1] = 0x02;
  req[2] = (wrong >> 24) & 0xFF;
  req[3] = (wrong >> 16) & 0xFF;
  req[4] = (wrong >> 8) & 0xFF;
  req[5] = wrong & 0xFF;
  return ExpNeg(req, 6, 0x27, expectNrc);
}

int ProgErased(void)
{
  byte req[4];
  dword len;

  if (EnterSession(0x02) == 0)
  {
    return 0;
  }
  if (DoUnlock(1) == 0)
  {
    return 0;
  }
  req[0] = 0x31;
  req[1] = 0x01;
  req[2] = 0xFF;
  req[3] = 0x00;
  len = UdsRequest(req, 4, gResp, 10000, cReqId);
  return ((len == 4) && (gResp[0] == 0x71) && (gResp[1] == 0x01) &&
          (gResp[2] == 0xFF) && (gResp[3] == 0x00));
}

int StartDownload(dword addr, dword size)
{
  byte req[11];
  dword len;

  req[0] = 0x34;
  req[1] = 0x00;
  req[2] = 0x44;
  req[3] = (addr >> 24) & 0xFF;
  req[4] = (addr >> 16) & 0xFF;
  req[5] = (addr >> 8) & 0xFF;
  req[6] = addr & 0xFF;
  req[7] = (size >> 24) & 0xFF;
  req[8] = (size >> 16) & 0xFF;
  req[9] = (size >> 8) & 0xFF;
  req[10] = size & 0xFF;
  len = UdsRequest(req, 11, gResp, 2000, cReqId);
  return ((len == 4) && (gResp[0] == 0x74) && (gResp[1] == 0x20) &&
          (gResp[2] == 0x02) && (gResp[3] == 0x00));
}

int DoDownload32(void)
{
  byte td[34];
  byte rt[1];
  dword i;
  dword len;

  if (StartDownload(cAppStart, 0x20) == 0)
  {
    return 0;
  }
  td[0] = 0x36;
  td[1] = 0x01;
  for (i = 0; i < 32; i++) { td[2 + i] = i & 0xFF; }
  len = UdsRequest(td, 34, gResp, 2000, cReqId);
  if ((len != 2) || (gResp[0] != 0x76) || (gResp[1] != 0x01))
  {
    return 0;
  }
  rt[0] = 0x37;
  len = UdsRequest(rt, 1, gResp, 2000, cReqId);
  return ((len == 1) && (gResp[0] == 0x77));
}

void BuildDownloadReq(byte req[], dword addr, dword size)
{
  req[0] = 0x34;
  req[1] = 0x00;
  req[2] = 0x44;
  req[3] = (addr >> 24) & 0xFF;
  req[4] = (addr >> 16) & 0xFF;
  req[5] = (addr >> 8) & 0xFF;
  req[6] = addr & 0xFF;
  req[7] = (size >> 24) & 0xFF;
  req[8] = (size >> 16) & 0xFF;
  req[9] = (size >> 8) & 0xFF;
  req[10] = size & 0xFF;
}

/* =====================================================================
 * Test cases
 * ===================================================================== */

/* ---- A. session control ---- */
testcase TC_A1()
{
  byte req[2];
  byte expect[6];

  TestCaseTitle("A1", "10 01 default session, P2/P2* advertisement");
  req[0] = 0x10; req[1] = 0x01;
  expect[0] = 0x50; expect[1] = 0x01; expect[2] = 0x00; expect[3] = 0x05; expect[4] = 0x01; expect[5] = 0xF4;
  if (ExpectResp(req, 2, expect, 6)) { TestStepPass("A1", "50 01 00 05 01 F4"); }
  else                     { TestStepFail("A1", "response mismatch"); }
}

testcase TC_A2()
{
  TestCaseTitle("A2", "10 02 programming session from default");
  if (EnterSession(0x02)) { TestStepPass("A2", "50 02"); }
  else                    { TestStepFail("A2", "enter programming failed"); }
}

testcase TC_A3()
{
  TestCaseTitle("A3", "10 03 extended session");
  if (EnterSession(0x03)) { TestStepPass("A3", "50 03"); }
  else                    { TestStepFail("A3", "enter extended failed"); }
}

testcase TC_A4()
{
  byte req[2];

  TestCaseTitle("A4", "10 04 invalid sub-function");
  req[0] = 0x10; req[1] = 0x04;
  if (ExpNeg(req, 2, 0x10, 0x12)) { TestStepPass("A4", "7F 10 12"); }
  else                            { TestStepFail("A4", "expected SFNS"); }
}

testcase TC_A5()
{
  byte req[2];

  TestCaseTitle("A5", "10 81 suppressPosRsp");
  req[0] = 0x10; req[1] = 0x81;
  if (ExpNoResp(req, 2)) { TestStepPass("A5", "no response"); }
  else                   { TestStepFail("A5", "unexpected response"); }
}

testcase TC_A6()
{
  byte req[1];

  TestCaseTitle("A6", "10 with length 1");
  req[0] = 0x10;
  if (ExpNeg(req, 1, 0x10, 0x13)) { TestStepPass("A6", "7F 10 13"); }
  else                            { TestStepFail("A6", "expected IMLOIF"); }
}

testcase TC_A7()
{
  byte req[11];

  TestCaseTitle("A7", "session change locks SecurityAccess");
  ToDefault();
  if (EnterSession(0x02) == 0)
  {
    TestStepFail("A7", "step1 enter programming (10 02) failed");
    return;
  }
  if (DoUnlock(1) == 0)
  {
    TestStepFail("A7", "step2 unlock L1 (27) failed");
    return;
  }
  if (EnterSession(0x01) == 0)
  {
    TestStepFail("A7", "step3 return default (10 01) failed");
    return;
  }
  if (EnterSession(0x02) == 0)
  {
    TestStepFail("A7", "step4 re-enter programming (10 02) failed");
    return;
  }
  BuildDownloadReq(req, cAppStart, 0x20);
  if (ExpNeg(req, 11, 0x34, 0x33))
  {
    TestStepPass("A7", "7F 34 33 after session change");
  }
  else
  {
    TestStepFail("A7", "step5 34 expected 7F 34 33");
  }
  ToDefault();
}

testcase TC_A8()
{
  byte req[2];
  dword len;

  TestCaseTitle("A8", "10 82 suppress enters programming without 50 02");
  req[0] = 0x10; req[1] = 0x82;
  if (ExpNoResp(req, 2) == 0) { TestStepFail("A8", "expected no 50 02"); return; }
  req[0] = 0x27; req[1] = 0x01;
  len = UdsRequest(req, 2, gResp, 2000, cReqId);
  if ((len == 6) && (gResp[0] == 0x67) && (gResp[1] == 0x01))
  {
    TestStepPass("A8", "no 50 02, 27 01 accepted");
  }
  else
  {
    TestStepFail("A8", "session not programming after 10 82");
  }
}

testcase TC_A9()
{
  byte req[2];

  TestCaseTitle("A9", "10 00 unsupported session -> SFNS");
  req[0] = 0x10; req[1] = 0x00;
  if (ExpNeg(req, 2, 0x10, 0x12)) { TestStepPass("A9", "7F 10 12"); }
  else                            { TestStepFail("A9", "expected SFNS"); }
}

testcase TC_A10()
{
  byte req[2];

  TestCaseTitle("A10", "10 FF unsupported session -> SFNS");
  req[0] = 0x10; req[1] = 0xFF;
  if (ExpNeg(req, 2, 0x10, 0x12)) { TestStepPass("A10", "7F 10 12"); }
  else                            { TestStepFail("A10", "expected SFNS"); }
}

testcase TC_A11()
{
  TestCaseTitle("A11", "legal switch matrix + P2/P2* in 50 xx");
  ToDefault();
  if (ExpectDsc(0x03) == 0) { TestStepFail("A11", "default -> extended"); return; }
  if (ExpectDsc(0x02) == 0) { TestStepFail("A11", "extended -> programming"); return; }
  if (ExpectDsc(0x01) == 0) { TestStepFail("A11", "programming -> default"); return; }
  if (ExpectDsc(0x02) == 0) { TestStepFail("A11", "default -> programming"); return; }
  TestStepPass("A11", "50 xx 00 05 01 F4 on all hops (default->prog allowed)");
}

testcase TC_A12()
{
  TestCaseTitle("A12", "re-enter same extended session -> 50 03");
  if (ExpectDsc(0x03) == 0) { TestStepFail("A12", "first 10 03"); return; }
  if (ExpectDsc(0x03)) { TestStepPass("A12", "second 10 03 still 50 03"); }
  else                 { TestStepFail("A12", "re-enter extended failed"); }
}

testcase TC_A13()
{
  byte vin[3];
  byte sa[2];
  byte rc[4];
  dword len;

  TestCaseTitle("A13", "service availability after session switch");
  if (ExpectDsc(0x03) == 0) { TestStepFail("A13", "enter extended"); return; }
  vin[0] = 0x22; vin[1] = 0xF1; vin[2] = 0x90;
  len = UdsRequest(vin, 3, gResp, 2000, cReqId);
  if ((len != 20) || (gResp[0] != 0x62) || (gResp[2] != 0x90))
  {
    TestStepFail("A13", "22 F190 in extended failed");
    return;
  }
  if (ExpectDsc(0x02) == 0) { TestStepFail("A13", "enter programming"); return; }
  sa[0] = 0x27; sa[1] = 0x01;
  len = UdsRequest(sa, 2, gResp, 2000, cReqId);
  if ((len != 6) || (gResp[0] != 0x67))
  {
    TestStepFail("A13", "27 01 in programming failed");
    return;
  }
  if (ExpectDsc(0x01) == 0) { TestStepFail("A13", "return default"); return; }
  rc[0] = 0x31; rc[1] = 0x01; rc[2] = 0xFF; rc[3] = 0x01;
  if (ExpNeg(rc, 4, 0x31, 0x7F)) { TestStepPass("A13", "ext 22 F190 / prog 27 / default 31 7F"); }
  else                           { TestStepFail("A13", "31 in default expected SNSIAS"); }
}

testcase TC_A14()
{
  byte wr[8];
  byte wrExp[3];

  TestCaseTitle("A14", "ext L1 persist across 10 02/10 03; prog stays locked");
  if (EnterSession(0x03) == 0) { TestStepFail("A14", "enter extended"); return; }
  if (DoUnlock(1) == 0)        { TestStepFail("A14", "unlock L1"); return; }
  wr[0] = 0x2E; wr[1] = 0xF1; wr[2] = 0x80; wr[3] = 0x01;
  wr[4] = 0xAA; wr[5] = 0xBB; wr[6] = 0xCC; wr[7] = 0xDD;
  wrExp[0] = 0x6E; wrExp[1] = 0xF1; wrExp[2] = 0x80;
  if (ExpectResp(wr, 8, wrExp, 3) == 0) { TestStepFail("A14", "2E while unlocked"); return; }
  if (EnterSession(0x02) == 0) { TestStepFail("A14", "switch programming"); RestoreF180(); return; }
  if (ExpNeg(wr, 8, 0x2E, 0x33) == 0) { TestStepFail("A14", "2E in prog expected SAD"); RestoreF180(); return; }
  if (EnterSession(0x03) == 0) { TestStepFail("A14", "back to extended"); RestoreF180(); return; }
  if (ExpectResp(wr, 8, wrExp, 3) == 0) { TestStepFail("A14", "2E after return should persist"); RestoreF180(); return; }
  RestoreF180();
  TestStepPass("A14", "L1 stays in extended; programming stays locked");
}

testcase TC_A15()
{
  byte wr[8];

  TestCaseTitle("A15", "ext L1 unlock then 10 01/10 03 clears security");
  if (EnterSession(0x03) == 0) { TestStepFail("A15", "enter extended"); return; }
  if (DoUnlock(1) == 0)        { TestStepFail("A15", "unlock L1"); return; }
  if (EnterSession(0x01) == 0) { TestStepFail("A15", "to default"); return; }
  if (EnterSession(0x03) == 0) { TestStepFail("A15", "back to extended"); return; }
  wr[0] = 0x2E; wr[1] = 0xF1; wr[2] = 0x80; wr[3] = 0x01;
  wr[4] = 0x11; wr[5] = 0x22; wr[6] = 0x33; wr[7] = 0x44;
  if (ExpNeg(wr, 8, 0x2E, 0x33)) { TestStepPass("A15", "2E -> 7F 2E 33 after default hop"); }
  else                           { TestStepFail("A15", "expected SAD"); }
}

testcase TC_A16()
{
  dword i;

  TestCaseTitle("A16", "20x session cycle 01-03-02-01");
  ToDefault();
  for (i = 0; i < 20; i++)
  {
    if (ExpectDsc(0x03) == 0) { TestStepFail("A16", "to extended"); return; }
    if (ExpectDsc(0x02) == 0) { TestStepFail("A16", "to programming"); return; }
    if (ExpectDsc(0x01) == 0) { TestStepFail("A16", "to default"); return; }
  }
  TestStepPass("A16", "20 cycles OK");
}

testcase TC_A17()
{
  byte req[2];
  dword len;
  dword i;
  byte hop[3];

  TestCaseTitle("A17", "1000x session cycle gap=0");
  hop[0] = 0x03; hop[1] = 0x02; hop[2] = 0x01;
  ToDefault();
  for (i = 0; i < 1000; i++)
  {
    req[0] = 0x10; req[1] = hop[i % 3];
    len = UdsRequestEx(req, 2, gResp, 2000, cReqId, 0);
    if ((len != 6) || (gResp[0] != 0x50) || (gResp[1] != hop[i % 3]))
    {
      write("A17: i=%d", i);
      TestStepFail("A17", "cycle failed");
      return;
    }
  }
  TestStepPass("A17", "1000 switches OK");
}

testcase TC_A18()
{
  byte wr[8];
  byte rd[11];

  TestCaseTitle("A18", "prog L1 persist across 10 03; extended stays locked");
  if (EnterSession(0x02) == 0) { TestStepFail("A18", "enter programming"); return; }
  if (DoUnlock(1) == 0)        { TestStepFail("A18", "unlock L1 in prog"); return; }
  if (EnterSession(0x03) == 0) { TestStepFail("A18", "switch extended"); return; }
  wr[0] = 0x2E; wr[1] = 0xF1; wr[2] = 0x80; wr[3] = 0x01;
  wr[4] = 0x11; wr[5] = 0x22; wr[6] = 0x33; wr[7] = 0x44;
  if (ExpNeg(wr, 8, 0x2E, 0x33) == 0) { TestStepFail("A18", "2E in ext expected SAD"); return; }
  if (EnterSession(0x02) == 0) { TestStepFail("A18", "back to programming"); return; }
  BuildDownloadReq(rd, cAppStart, 0x20);
  if (ExpNeg(rd, 11, 0x34, 0x22)) { TestStepPass("A18", "ext locked; prog L1 kept (34 CNC not SAD)"); }
  else                            { TestStepFail("A18", "34 expected CNC (unlocked, not erased)"); }
}

/* ---- B. security access ---- */
testcase TC_B1()
{
  byte req[2];

  TestCaseTitle("B1", "27 01 in default session");
  ToDefault();
  req[0] = 0x27; req[1] = 0x01;
  if (ExpNeg(req, 2, 0x27, 0x7F)) { TestStepPass("B1", "7F 27 7F"); }
  else                            { TestStepFail("B1", "expected SNSIAS"); }
}

testcase TC_B2()
{
  byte req[2];
  dword len;

  TestCaseTitle("B2", "27 01 seed request");
  if (EnterSession(0x02) == 0) { TestStepFail("B2", "enter programming"); return; }
  req[0] = 0x27; req[1] = 0x01;
  len = UdsRequest(req, 2, gResp, 2000, cReqId);
  if ((len == 6) && (gResp[0] == 0x67) && (gResp[1] == 0x01)) { TestStepPass("B2", "seed received"); }
  else                                                        { TestStepFail("B2", "seed failed"); }
}

testcase TC_B3()
{
  byte req[11];
  dword len;
  dword seed;
  dword wrong;

  TestCaseTitle("B3", "27 02 wrong key -> IK and stays locked");
  if (EnterSession(0x02) == 0) { TestStepFail("B3", "enter programming"); return; }
  req[0] = 0x27; req[1] = 0x01;
  len = UdsRequest(req, 2, gResp, 2000, cReqId);
  if (len != 6) { TestStepFail("B3", "no seed"); return; }
  seed = (((dword)gResp[2]) << 24) | (((dword)gResp[3]) << 16) |
         (((dword)gResp[4]) << 8)  | ((dword)gResp[5]);
  wrong = (seed ^ 0xFFFFFFFF) ^ 0x55;
  req[0] = 0x27; req[1] = 0x02;
  req[2] = (wrong >> 24) & 0xFF; req[3] = (wrong >> 16) & 0xFF;
  req[4] = (wrong >> 8) & 0xFF;  req[5] = wrong & 0xFF;
  if (ExpNeg(req, 6, 0x27, 0x35) == 0) { TestStepFail("B3", "expected IK"); return; }
  BuildDownloadReq(req, cAppStart, 0x20);
  if (ExpNeg(req, 11, 0x34, 0x33)) { TestStepPass("B3", "7F 27 35 + still locked"); }
  else                             { TestStepFail("B3", "security not locked"); }
}

testcase TC_B4()
{
  byte req[11];

  TestCaseTitle("B4", "27 02 correct key unlocks security");
  if (EnterSession(0x02) == 0) { TestStepFail("B4", "enter programming"); return; }
  if (DoUnlock(1) == 0)        { TestStepFail("B4", "unlock failed"); return; }
  BuildDownloadReq(req, cAppStart, 0x20);
  if (ExpNeg(req, 11, 0x34, 0x22)) { TestStepPass("B4", "34 -> 7F 34 22 (past security gate)"); }
  else                             { TestStepFail("B4", "expected CNC"); }
}

testcase TC_B5()
{
  byte req[2];
  byte expect[6];

  TestCaseTitle("B5", "27 01 when already unlocked -> zero seed");
  if (EnterSession(0x02) == 0) { TestStepFail("B5", "enter programming"); return; }
  if (DoUnlock(1) == 0)        { TestStepFail("B5", "unlock failed"); return; }
  req[0] = 0x27; req[1] = 0x01;
  expect[0] = 0x67; expect[1] = 0x01; expect[2] = 0; expect[3] = 0; expect[4] = 0; expect[5] = 0;
  if (ExpectResp(req, 2, expect, 6)) { TestStepPass("B5", "zero seed"); }
  else                     { TestStepFail("B5", "expected zero seed"); }
}

testcase TC_B6()
{
  byte req[6];

  TestCaseTitle("B6", "27 02 key without seed -> RSE");
  if (EnterSession(0x02) == 0) { TestStepFail("B6", "enter programming"); return; }
  req[0] = 0x27; req[1] = 0x02; req[2] = 0xAA; req[3] = 0xBB; req[4] = 0xCC; req[5] = 0xDD;
  if (ExpNeg(req, 6, 0x27, 0x24)) { TestStepPass("B6", "7F 27 24"); }
  else                            { TestStepFail("B6", "expected RSE"); }
}

testcase TC_B7()
{
  byte req[2];

  TestCaseTitle("B7", "27 05 invalid sub-function");
  if (EnterSession(0x02) == 0) { TestStepFail("B7", "enter programming"); return; }
  req[0] = 0x27; req[1] = 0x05;
  if (ExpNeg(req, 2, 0x27, 0x12)) { TestStepPass("B7", "7F 27 12"); }
  else                            { TestStepFail("B7", "expected SFNS"); }
}

testcase TC_B8()
{
  byte req[11];

  TestCaseTitle("B8", "L3 unlock does not grant L1 services");
  if (EnterSession(0x02) == 0) { TestStepFail("B8", "enter programming"); return; }
  if (DoUnlock(3) == 0)        { TestStepFail("B8", "L3 unlock failed"); return; }
  BuildDownloadReq(req, cAppStart, 0x20);
  if (ExpNeg(req, 11, 0x34, 0x33)) { TestStepPass("B8", "34 -> 7F 34 33"); }
  else                             { TestStepFail("B8", "expected SAD"); }
}

testcase TC_B9()
{
  byte req[6];

  TestCaseTitle("B9", "27 81 suppress still requests seed (27 02 dummy -> IK)");
  if (EnterSession(0x02) == 0) { TestStepFail("B9", "enter programming"); return; }
  req[0] = 0x27; req[1] = 0x81;
  if (ExpNoResp(req, 2) == 0) { TestStepFail("B9", "expected no 67 01"); return; }
  req[0] = 0x27; req[1] = 0x02;
  req[2] = 0x11; req[3] = 0x22; req[4] = 0x33; req[5] = 0x44;
  if (ExpNeg(req, 6, 0x27, 0x35)) { TestStepPass("B9", "7F 27 35 (seed was stored)"); }
  else                            { TestStepFail("B9", "expected IK (not RSE)"); }
}

testcase TC_B10()
{
  byte req[2];

  TestCaseTitle("B10", "27 00 illegal sub-function -> SFNS");
  if (EnterSession(0x02) == 0) { TestStepFail("B10", "enter programming"); return; }
  req[0] = 0x27; req[1] = 0x00;
  if (ExpNeg(req, 2, 0x27, 0x12)) { TestStepPass("B10", "7F 27 12"); }
  else                            { TestStepFail("B10", "expected SFNS"); }
}

testcase TC_B11()
{
  byte seedReq[3];
  byte shortKey[4];

  TestCaseTitle("B11", "27 01 extra byte / 27 02 short key -> IMLOIF");
  if (EnterSession(0x02) == 0) { TestStepFail("B11", "enter programming"); return; }
  seedReq[0] = 0x27; seedReq[1] = 0x01; seedReq[2] = 0x00;
  if (ExpNeg(seedReq, 3, 0x27, 0x13) == 0) { TestStepFail("B11", "27 01 extra expected IMLOIF"); return; }
  if (UdsRequest(seedReq, 2, gResp, 2000, cReqId) != 6)
  {
    TestStepFail("B11", "seed for short-key check");
    return;
  }
  shortKey[0] = 0x27; shortKey[1] = 0x02; shortKey[2] = 0xAA; shortKey[3] = 0xBB;
  if (ExpNeg(shortKey, 4, 0x27, 0x13)) { TestStepPass("B11", "7F 27 13"); }
  else                                  { TestStepFail("B11", "27 02 short key expected IMLOIF"); }
}

testcase TC_B12()
{
  byte req[2];

  TestCaseTitle("B12", "3 wrong keys -> 0x36 then seed -> 0x37");
  if (EnterSession(0x02) == 0) { TestStepFail("B12", "enter programming"); return; }
  /* B3/B9 leave SaAttempts > 0 (delay/attempt survive session hop).
   * Unlock success zeros the counter; 10 01 then locks again. */
  if (DoUnlock(1) == 0)        { TestStepFail("B12", "reset attempt counter"); return; }
  ToDefault();
  if (EnterSession(0x02) == 0) { TestStepFail("B12", "re-enter programming"); return; }
  if (SendWrongKey(0x35) == 0) { TestStepFail("B12", "1st IK expected 0x35"); return; }
  if (SendWrongKey(0x35) == 0) { TestStepFail("B12", "2nd IK expected 0x35"); return; }
  if (SendWrongKey(0x36) == 0) { TestStepFail("B12", "3rd IK expected 0x36"); return; }
  req[0] = 0x27; req[1] = 0x01;
  if (ExpNeg(req, 2, 0x27, 0x37)) { TestStepPass("B12", "7F 27 35/35/36 then 7F 27 37"); }
  else                            { TestStepFail("B12", "seed during delay expected 0x37"); }
}

testcase TC_B13()
{
  byte req[2];
  byte tp[2];
  byte tpExp[2];
  dword len;
  dword i;

  TestCaseTitle("B13", "after 0x36 wait 10 s then 27 01 allowed");
  if (EnterSession(0x02) == 0) { TestStepFail("B13", "enter programming"); return; }
  req[0] = 0x27; req[1] = 0x01;
  len = UdsRequest(req, 2, gResp, 2000, cReqId);
  if ((len == 3) && (gResp[0] == 0x7F) && (gResp[2] == 0x37))
  {
    /* delay already running (typically after B12) */
  }
  else
  {
    if (SendWrongKey(0x35) == 0) { TestStepFail("B13", "arm delay: 1st IK"); return; }
    if (SendWrongKey(0x35) == 0) { TestStepFail("B13", "arm delay: 2nd IK"); return; }
    if (SendWrongKey(0x36) == 0) { TestStepFail("B13", "arm delay: 3rd IK"); return; }
  }
  tp[0] = 0x3E; tp[1] = 0x00;
  tpExp[0] = 0x7E; tpExp[1] = 0x00;
  for (i = 0; i < 11; i++)
  {
    if (ExpectResp(tp, 2, tpExp, 2) == 0) { TestStepFail("B13", "3E keepalive"); return; }
    TestWaitForTimeout(1000);
  }
  req[0] = 0x27; req[1] = 0x01;
  len = UdsRequest(req, 2, gResp, 2000, cReqId);
  if ((len == 6) && (gResp[0] == 0x67) && (gResp[1] == 0x01))
  {
    TestStepPass("B13", "67 01 after delay");
  }
  else
  {
    TestStepFail("B13", "seed after 10 s delay failed");
  }
}

/* ---- C. permission matrix / negative codes ---- */
testcase TC_C1()
{
  byte req[3];
  byte expect[8];

  TestCaseTitle("C1", "22 F180 read boot software");
  req[0] = 0x22; req[1] = 0xF1; req[2] = 0x80;
  expect[0] = 0x62; expect[1] = 0xF1; expect[2] = 0x80; expect[3] = 0x01;
  expect[4] = 0x42; expect[5] = 0x4F; expect[6] = 0x4F; expect[7] = 0x54;
  if (ExpectResp(req, 3, expect, 8)) { TestStepPass("C1", "62 F1 80 01 42 4F 4F 54"); }
  else                     { TestStepFail("C1", "response mismatch"); }
}

testcase TC_C2()
{
  byte req[3];

  TestCaseTitle("C2", "22 invalid DID -> ROOR");
  req[0] = 0x22; req[1] = 0xF2; req[2] = 0x00;
  if (ExpNeg(req, 3, 0x22, 0x31)) { TestStepPass("C2", "7F 22 31"); }
  else                            { TestStepFail("C2", "expected ROOR"); }
}

testcase TC_C3()
{
  byte req[2];

  TestCaseTitle("C3", "22 wrong length -> IMLOIF");
  req[0] = 0x22; req[1] = 0xF1;
  if (ExpNeg(req, 2, 0x22, 0x13)) { TestStepPass("C3", "7F 22 13"); }
  else                            { TestStepFail("C3", "expected IMLOIF"); }
}

testcase TC_C4()
{
  byte req[8];

  TestCaseTitle("C4", "2E in default -> SNSIAS");
  req[0] = 0x2E; req[1] = 0xF1; req[2] = 0x80; req[3] = 0x01;
  req[4] = 0xAA; req[5] = 0xBB; req[6] = 0xCC; req[7] = 0xDD;
  if (ExpNeg(req, 8, 0x2E, 0x7F)) { TestStepPass("C4", "7F 2E 7F"); }
  else                            { TestStepFail("C4", "expected SNSIAS"); }
}

testcase TC_C5()
{
  byte req[8];

  TestCaseTitle("C5", "2E in extended locked -> SAD");
  if (EnterSession(0x03) == 0) { TestStepFail("C5", "enter extended"); return; }
  req[0] = 0x2E; req[1] = 0xF1; req[2] = 0x80; req[3] = 0x01;
  req[4] = 0xAA; req[5] = 0xBB; req[6] = 0xCC; req[7] = 0xDD;
  if (ExpNeg(req, 8, 0x2E, 0x33)) { TestStepPass("C5", "7F 2E 33"); }
  else                            { TestStepFail("C5", "expected SAD"); }
}

testcase TC_C6()
{
  byte wr[8];
  byte wrExp[3];
  byte rd[3];
  byte rdExp[8];

  TestCaseTitle("C6", "2E write / 22 read-back in extended with L1");
  if (EnterSession(0x03) == 0) { TestStepFail("C6", "enter extended"); return; }
  if (DoUnlock(1) == 0)        { TestStepFail("C6", "unlock failed"); return; }
  wr[0] = 0x2E; wr[1] = 0xF1; wr[2] = 0x80; wr[3] = 0x01;
  wr[4] = 0xAA; wr[5] = 0xBB; wr[6] = 0xCC; wr[7] = 0xDD;
  wrExp[0] = 0x6E; wrExp[1] = 0xF1; wrExp[2] = 0x80;
  if (ExpectResp(wr, 8, wrExp, 3) == 0)
  {
    TestStepFail("C6", "write failed");
    return;
  }
  rd[0] = 0x22; rd[1] = 0xF1; rd[2] = 0x80;
  rdExp[0] = 0x62; rdExp[1] = 0xF1; rdExp[2] = 0x80; rdExp[3] = 0x01;
  rdExp[4] = 0xAA; rdExp[5] = 0xBB; rdExp[6] = 0xCC; rdExp[7] = 0xDD;
  if (ExpectResp(rd, 3, rdExp, 8)) { TestStepPass("C6", "write + read-back OK"); }
  else                      { TestStepFail("C6", "read-back mismatch"); }
  /* restore the original F180 content so later cases (D1/G2) stay order-independent */
  wr[0] = 0x2E; wr[1] = 0xF1; wr[2] = 0x80; wr[3] = 0x01;
  wr[4] = 0x42; wr[5] = 0x4F; wr[6] = 0x4F; wr[7] = 0x54;
  ExpectResp(wr, 8, wrExp, 3);
}

testcase TC_C7()
{
  byte req[4];

  TestCaseTitle("C7", "31 in default -> SNSIAS");
  req[0] = 0x31; req[1] = 0x01; req[2] = 0xFF; req[3] = 0x01;
