testcase TC_C22()
{
  byte req[3];
  dword len;

  TestCaseTitle("C22", "extended 22 F187 / F18C / F193 / F189 stub DIDs");
  if (EnterSession(0x03) == 0) { TestStepFail("C22", "enter extended"); return; }
  req[0] = 0x22; req[1] = 0xF1; req[2] = 0x87;
  len = UdsRequest(req, 3, gResp, 2000, cReqId);
  if ((len != 7) || (gResp[0] != 0x62) || (gResp[1] != 0xF1) || (gResp[2] != 0x87))
  {
    TestStepFail("C22", "F187 mismatch");
    return;
  }
  req[2] = 0x8C;
  len = UdsRequest(req, 3, gResp, 2000, cReqId);
  if ((len != 7) || (gResp[0] != 0x62) || (gResp[2] != 0x8C))
  {
    TestStepFail("C22", "F18C mismatch");
    return;
  }
  req[2] = 0x93;
  len = UdsRequest(req, 3, gResp, 2000, cReqId);
  if ((len != 7) || (gResp[0] != 0x62) || (gResp[2] != 0x93))
  {
    TestStepFail("C22", "F193 mismatch");
    return;
  }
  req[2] = 0x89;
  len = UdsRequest(req, 3, gResp, 2000, cReqId);
  if ((len == 16) && (gResp[0] == 0x62) && (gResp[1] == 0xF1) && (gResp[2] == 0x89))
  {
    TestStepPass("C22", "F187/F18C/F193/F189 OK");
  }
  else
  {
    TestStepFail("C22", "F189 mismatch");
  }
}

testcase TC_C23()
{
  byte req[3];
  dword len;
  dword i;

  TestCaseTitle("C23", "extended 22 F190 VIN 20-byte multi-frame response");
  if (EnterSession(0x03) == 0) { TestStepFail("C23", "enter extended"); return; }
  req[0] = 0x22; req[1] = 0xF1; req[2] = 0x90;
  len = UdsRequest(req, 3, gResp, 2000, cReqId);
  if ((len != 20) || (gResp[0] != 0x62) || (gResp[1] != 0xF1) || (gResp[2] != 0x90))
  {
    TestStepFail("C23", "VIN header/len mismatch");
    return;
  }
  for (i = 3; i < 20; i++)
  {
    if (gResp[i] != 0)
    {
      TestStepFail("C23", "VIN stub not zero");
      return;
    }
  }
  TestStepPass("C23", "62 F1 90 + 17 zeros (ISO-TP FF/CF)");
}

