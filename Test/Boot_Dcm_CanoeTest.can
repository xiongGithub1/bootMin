  if (EnterSession(0x01) == 0) { TestStepFail("E8", "return default"); return; }
  if (EnterSession(0x02) == 0) { TestStepFail("E8", "re-enter programming"); return; }
  req[0] = 0x36; req[1] = 0x01;
  for (i = 0; i < 32; i++) { req[2 + i] = i & 0xFF; }
  if (ExpNeg(req, 34, 0x36, 0x33)) { TestStepPass("E8", "7F 36 33"); }
  else                             { TestStepFail("E8", "expected SAD"); }
}

