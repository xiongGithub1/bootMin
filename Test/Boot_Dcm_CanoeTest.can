/* =====================================================================
 * Main test sequence
 * ===================================================================== */
void MainTest()
{
  write("Boot_Dcm_CanoeTest: starting");

  /* ---- A. session control ---- */
  TestGroupBegin("A - Session", "DiagnosticSessionControl");
  TC_A1(); ToDefault(); TC_A2(); ToDefault(); TC_A3(); ToDefault();
  TC_A4(); ToDefault(); TC_A5(); ToDefault(); TC_A6(); ToDefault();
  TC_A7(); ToDefault(); TC_A8(); ToDefault();
  TC_A9(); ToDefault(); TC_A10(); ToDefault(); TC_A11(); ToDefault();
  TC_A12(); ToDefault(); TC_A13(); ToDefault(); TC_A14(); ToDefault();
  TC_A15(); ToDefault(); TC_A16(); ToDefault(); TC_A18(); ToDefault();
  if (gRunStress)
  {
    TC_A17(); ToDefault();
  }
  else
  {
    TC_A17_Skipped();
  }
  TestGroupEnd();

  /* ---- B. security access ---- */
  TestGroupBegin("B - SecurityAccess", "0x27 seed/key, wrong key, levels");
  TC_B1(); ToDefault(); TC_B2(); ToDefault(); TC_B3(); ToDefault();
  TC_B4(); ToDefault(); TC_B5(); ToDefault(); TC_B6(); ToDefault();
  TC_B7(); ToDefault(); TC_B8(); ToDefault(); TC_B9(); ToDefault();
  TC_B10(); ToDefault(); TC_B11(); ToDefault(); TC_B12(); ToDefault(); TC_B13(); ToDefault();
  TestGroupEnd();

  /* ---- C. permission matrix ---- */
  TestGroupBegin("C - Matrix", "session/security gating + negative codes");
  TC_C1(); ToDefault(); TC_C2(); ToDefault(); TC_C3(); ToDefault();
  TC_C4(); ToDefault(); TC_C5(); ToDefault(); TC_C6(); ToDefault();
  TC_C7(); ToDefault(); TC_C8(); ToDefault(); TC_C9(); ToDefault();
  TC_C10(); ToDefault(); TC_C11(); ToDefault(); TC_C12(); ToDefault();
  TC_C13(); ToDefault(); TC_C14(); ToDefault(); TC_C15(); ToDefault();
  TC_C16(); ToDefault(); TC_C17(); ToDefault(); TC_C18(); ToDefault();
  TC_C19(); ToDefault(); TC_C20(); ToDefault(); TC_C21(); ToDefault();
  TC_C22(); ToDefault(); TC_C23(); ToDefault(); TC_C24(); ToDefault();
  TC_C25(); ToDefault(); TC_C26(); ToDefault(); TC_C27(); ToDefault();
  TC_C28(); ToDefault(); TC_C29(); ToDefault(); TC_C30(); ToDefault();
  TC_C31(); ToDefault();
  TestGroupEnd();

  /* ---- D. timing ---- */
  TestGroupBegin("D - Timing", "P2 / P2* / S3");
  TC_D1(); ToDefault(); TC_D2(); ToDefault(); TC_D3(); ToDefault(); TC_D4(); ToDefault();
  TC_D5(); ToDefault(); TC_D6(); ToDefault(); TC_D7(); ToDefault();
  TestGroupEnd();

  /* ---- H. CanTp TX serialize ---- */
  TestGroupBegin("H - CanTp TX", "back-to-back requests, no 20 ms gap");
  TC_H1(); ToDefault(); TC_H2(); ToDefault(); TC_H3(); ToDefault();
  TC_H4(); ToDefault(); TC_H5(); ToDefault();
  TestGroupEnd();

  /* ---- E. flash programming ---- */
  TestGroupBegin("E - Flash", "programming flow (destructive)");
  if (gRunFlash)
  {
    TC_E1(); ToDefault(); TC_E2(); ToDefault(); TC_E3(); ToDefault();
    TC_E4(); ToDefault(); TC_E5(); ToDefault(); TC_E6(); ToDefault();
    TC_E7(); ToDefault(); TC_E8(); ToDefault(); TC_E9(); ToDefault();
    TC_E12(); ToDefault(); TC_E13(); ToDefault();
    TC_E14(); ToDefault(); TC_E15(); ToDefault(); TC_E16(); ToDefault();
    TC_E18(); ToDefault();
  }
  else
  {
    TC_E_Skipped();
  }
  TestGroupEnd();

  /* ---- F. ECU reset ---- */
  TestGroupBegin("F - Reset", "ECUReset");
  if (gRunReset)
  {
    TC_F1(); ToDefault(); TC_F2(); ToDefault(); TC_F4(); ToDefault();
  }
  else
  {
    TC_F_Skipped();
  }
  TC_F3(); ToDefault();
  TestGroupEnd();

  /* ---- G. functional addressing ---- */
  TestGroupBegin("G - Functional", "requests via 0x7DF");
  TC_G1(); ToDefault(); TC_G2(); ToDefault(); TC_G3(); ToDefault();
  TestGroupEnd();

  ToDefault();
  write("Boot_Dcm_CanoeTest: finished");
}
